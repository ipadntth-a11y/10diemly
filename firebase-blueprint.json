{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated teacher or student profile",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "email": {
          "type": "string",
          "format": "email",
          "maxLength": 200
        },
        "displayName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "role": {
          "type": "string",
          "enum": ["teacher", "student"]
        },
        "seeded": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["uid", "email", "displayName", "role", "createdAt", "updatedAt"]
    },
    "Classroom": {
      "title": "Classroom",
      "description": "A school class managed by a teacher",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "teacherId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "subject": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "grade": {
          "type": "string",
          "maxLength": 30
        },
        "academicYear": {
          "type": "string",
          "maxLength": 30
        },
        "joinCode": {
          "type": "string",
          "minLength": 3,
          "maxLength": 20,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "studentCount": {
          "type": "integer"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "teacherId", "name", "subject", "joinCode", "studentCount", "createdAt", "updatedAt"]
    },
    "StudentRecord": {
      "title": "StudentRecord",
      "description": "Student entry inside a class roster (contains parent phone PII restricted to owning teacher)",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "classId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "teacherId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "fullName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "studentCode": {
          "type": "string",
          "maxLength": 40
        },
        "parentPhone": {
          "type": "string",
          "maxLength": 30
        },
        "parentName": {
          "type": "string",
          "maxLength": 120
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "classId", "teacherId", "fullName", "createdAt", "updatedAt"]
    },
    "Exam": {
      "title": "Exam",
      "description": "An online assessment created by a teacher with MCQ, True/False, 4-box Short Answer, and Essay questions including embedded question images",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "teacherId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "subject": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "examCode": {
          "type": "string",
          "minLength": 3,
          "maxLength": 30,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "durationMinutes": {
          "type": "integer"
        },
        "isPublished": {
          "type": "boolean"
        },
        "questionCount": {
          "type": "integer"
        },
        "questions": {
          "type": "array"
        },
        "assignedClassIds": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 128
          }
        },
        "assignedClassNames": {
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 100
          }
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "teacherId", "title", "subject", "examCode", "durationMinutes", "isPublished", "questionCount", "questions", "createdAt", "updatedAt"]
    },
    "Submission": {
      "title": "Submission",
      "description": "A student submission for an exam including per-question answers, timing, violations, and teacher grading",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "examId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "examTitle": {
          "type": "string",
          "maxLength": 200
        },
        "teacherId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "studentUid": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "studentCode": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "classJoinCode": {
          "type": "string",
          "minLength": 3,
          "maxLength": 30,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "studentName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "className": {
          "type": "string",
          "maxLength": 80
        },
        "durationSeconds": {
          "type": "integer"
        },
        "violationCount": {
          "type": "integer"
        },
        "status": {
          "type": "string",
          "enum": ["graded", "pending_essay"]
        },
        "totalScore": {
          "type": "number"
        },
        "maxScore": {
          "type": "number"
        },
        "teacherComment": {
          "type": "string",
          "maxLength": 2000
        },
        "aiAnalysis": {
          "type": "string",
          "maxLength": 4000
        },
        "parentPhone": {
          "type": "string",
          "maxLength": 30
        },
        "answers": {
          "type": "array"
        },
        "submittedAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "examId", "examTitle", "teacherId", "studentUid", "studentName", "durationSeconds", "violationCount", "status", "totalScore", "maxScore", "answers", "submittedAt", "updatedAt"]
    },
    "ParentMessage": {
      "title": "ParentMessage",
      "description": "SMS/Zalo parent notification message drafted or sent by a teacher",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "teacherId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "submissionId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "studentName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "className": {
          "type": "string",
          "maxLength": 80
        },
        "examTitle": {
          "type": "string",
          "maxLength": 200
        },
        "parentPhone": {
          "type": "string",
          "maxLength": 30
        },
        "content": {
          "type": "string",
          "minLength": 1,
          "maxLength": 2000
        },
        "status": {
          "type": "string",
          "enum": ["draft", "sent"]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "teacherId", "studentName", "examTitle", "content", "status", "createdAt", "updatedAt"]
    },
    "StudentCodeIndex": {
      "title": "StudentCodeIndex",
      "description": "Non-PII lookup index mapping a teacher's studentCode to studentName and className for unauthenticated exam entry",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "teacherId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "classId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "className": {
          "type": "string",
          "maxLength": 100
        },
        "studentCode": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "studentName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "teacherId", "classId", "className", "studentCode", "studentName", "createdAt", "updatedAt"]
    },
    "ClassRoster": {
      "title": "ClassRoster",
      "description": "Non-PII class roster lookup indexed by class joinCode so students can enter a class and pick their name without exposing parent PII",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 3,
          "maxLength": 30,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "teacherId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "classId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "className": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "subject": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "joinCode": {
          "type": "string",
          "minLength": 3,
          "maxLength": 30,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "studentEntries": {
          "type": "array"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "teacherId", "classId", "className", "subject", "joinCode", "studentEntries", "createdAt", "updatedAt"]
    },
    "StudentJournal": {
      "title": "StudentJournal",
      "description": "Non-PII teacher-synced student learning journal summarizing chronological exam attempts, scores, and effort diagnostics",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "teacherId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "studentKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "studentName": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "className": {
          "type": "string",
          "maxLength": 80
        },
        "studentCode": {
          "type": "string",
          "maxLength": 40
        },
        "entries": {
          "type": "array"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "teacherId", "studentKey", "studentName", "className", "entries", "createdAt", "updatedAt"]
    },
    "ReferenceMaterial": {
      "title": "ReferenceMaterial",
      "description": "Teacher-curated standard question bank, formulas, and curriculum reference material extracted from Word (.docx) or authored manually to ground AI practice and exam generation",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "teacherId": {
          "type": "string",
          "maxLength": 128,
          "pattern": "^[a-zA-Z0-9_\\-]+$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "subject": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        },
        "topic": {
          "type": "string",
          "maxLength": 160
        },
        "grade": {
          "type": "string",
          "maxLength": 40
        },
        "sourceFileName": {
          "type": "string",
          "maxLength": 200
        },
        "knowledgeSummary": {
          "type": "string",
          "maxLength": 8000
        },
        "items": {
          "type": "array"
        },
        "itemCount": {
          "type": "integer"
        },
        "isActiveForAi": {
          "type": "boolean"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": ["id", "teacherId", "title", "subject", "topic", "grade", "sourceFileName", "knowledgeSummary", "items", "itemCount", "isActiveForAi", "createdAt", "updatedAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User profiles keyed by Firebase Auth UID"
    },
    "/classes/{classId}": {
      "schema": { "$ref": "#/entities/Classroom" },
      "description": "Classes owned by teachers"
    },
    "/classes/{classId}/students/{studentId}": {
      "schema": { "$ref": "#/entities/StudentRecord" },
      "description": "Students enrolled in a class"
    },
    "/studentCodes/{codeId}": {
      "schema": { "$ref": "#/entities/StudentCodeIndex" },
      "description": "Public exact-ID lookup index for verifying student codes without exposing parent PII"
    },
    "/classRosters/{joinCode}": {
      "schema": { "$ref": "#/entities/ClassRoster" },
      "description": "Public exact-ID class roster lookup keyed by joinCode without exposing parent PII"
    },
    "/exams/{examId}": {
      "schema": { "$ref": "#/entities/Exam" },
      "description": "Exams created by teachers"
    },
    "/submissions/{submissionId}": {
      "schema": { "$ref": "#/entities/Submission" },
      "description": "Student exam submissions and teacher grades"
    },
    "/parentMessages/{messageId}": {
      "schema": { "$ref": "#/entities/ParentMessage" },
      "description": "Parent notification messages owned by teachers"
    },
    "/studentJournals/{journalId}": {
      "schema": { "$ref": "#/entities/StudentJournal" },
      "description": "Non-PII learning journal snapshots keyed by deterministic teacherId_studentKey"
    },
    "/referenceMaterials/{materialId}": {
      "schema": { "$ref": "#/entities/ReferenceMaterial" },
      "description": "Standard question banks and curriculum notes uploaded by teachers to ground AI generation"
    }
  }
}
