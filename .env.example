# GEMINI_API_KEY: Optional legacy server-side key.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# VITE_GEMINI_API_KEY: Required for direct browser-side Gemini AI calls (set in Vercel Environment Variables or .env).
VITE_GEMINI_API_KEY="MY_GEMINI_API_KEY"

# VITE_GEMINI_API_KEYS: Optional comma-separated backup keys (from separate Cloud projects) for auto-failover on quota errors.
VITE_GEMINI_API_KEYS=""

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
